# ── LLM ───────────────────────────────────────────────────────────────
# auto = try Ollama first, then OpenAI
# local = Ollama only
# mock = no LLM (keyword fallback only)
LLM_MODE=auto

LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma3:1b

# Required only when LLM_MODE=auto or cloud and Ollama not running
# OPENAI_API_KEY=sk-...

# ── Executor ──────────────────────────────────────────────────────────
# 1 = mock mode (safe testing, no robot HW needed)
# 0 = real ROS2 execution
EXECUTOR_MOCK=1

# ── Perception ────────────────────────────────────────────────────────
# 1 = show OpenCV camera window (requires a display connected)
# 0 = headless (default — Jetson runs without monitor)
SHOW_DISPLAY=0

# ── Texture analysis ──────────────────────────────────────────────────
# 0 = disabled (saves ~200MB RAM) — activates automatically on demand when
#     two similar-looking objects are detected at the same depth
# 1 = load TextureAnalyzer at startup
ENABLE_TEXTURE=0

# ── Experience memory ─────────────────────────────────────────────────
# 0 = disabled (saves ~500MB RAM — sentence-transformers not loaded)
# 1 = enable semantic experience retrieval
ENABLE_EXPERIENCE_MEMORY=0

# ── World model ───────────────────────────────────────────────────────
# Seconds before an unseen object is removed from world model
STALE_OBJECT_AGE=5.0

# ── Nav2 ──────────────────────────────────────────────────────────────
NAV2_APPROACH_DIST=0.4
NAV2_GOAL_TIMEOUT=60.0
NAV2_SERVER_TIMEOUT=5.0

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379


# Camera topics
RGB_TOPIC=/camera/camera/color/image_raw
DEPTH_TOPIC=/camera/camera/depth/image_rect_raw
INFO_TOPIC=/camera/camera/color/camera_info
CAMERA_FRAME=camera_link
